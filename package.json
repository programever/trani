{
  "name": "trani",
  "version": "1.0.0",
  "private": true,
  "description": "Trani: training plan for the 65 km Núi Dinh race, one day at a time (today and the next 7 days), with a done button and feel buttons per day. Records live in Firestore.",
  "type": "module",
  "scripts": {
    "check": "node tools/gen-days.mjs && tsc --noEmit",
    "test": "npm run check && node --test test/plan.test.ts",
    "build": "node tools/gen-days.mjs && node build.mjs",
    "test:browser": "node --test test/browser.test.ts",
    "serve": "python3 -m http.server 8766 --bind 127.0.0.1 --directory dist",
    "days": "node tools/next-day.ts",
    "daily": "tools/daily.sh"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "esbuild": "^0.25.0",
    "firebase": "^12.19.0",
    "playwright": "^1.50.0",
    "typescript": "^5.9.0"
  }
}
